# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# rules | hybrid (rules first, LLM when unsure) | llm (LLM every turn)
NLU_MODE=hybrid
# ollama = free local model (install Ollama, then: ollama pull qwen2.5:1.5b) | anthropic = Claude API key
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT=8
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# mock = built-in simulated bank | neon = shared Neon database | http = BANKING_API_URL
BANK_BACKEND=mock
# Same Neon URL as server/.env (needed when BANK_BACKEND=neon)
DATABASE_URL=
BANKING_API_URL=
# true only when running without the team server (the server records call history)
RECORD_CALLS=false
STT_MODEL=base.en
STT_BEAM=1
STT_MIN_CONFIDENCE=0.45
# browser = frontend speaks reply_text | edge = backend returns an mp3 URL
TTS_PROVIDER=browser
