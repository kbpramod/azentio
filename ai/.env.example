# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# auto = Claude if a key is set, else rules | llm | rules
NLU_MODE=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Empty = built-in SIMULATED mock bank. Set to Member B's API, e.g. http://localhost:8000
BANKING_API_URL=
STT_MODEL=small
STT_MIN_CONFIDENCE=0.6
# browser = frontend speaks reply_text | edge = backend returns an mp3 URL
TTS_PROVIDER=browser
