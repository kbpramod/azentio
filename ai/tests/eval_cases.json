  ]},
  {"id": "J13-no-data-before-verify", "scenario": "9", "turns": [
    {"say": "What's my account balance?", "expect": {"verified": false, "reply_not_contains": ["₹"], "reply_contains": ["customer ID"]}}
  ]}
